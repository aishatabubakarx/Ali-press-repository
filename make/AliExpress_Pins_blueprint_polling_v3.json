{
  "name": "AliExpress Pins - GitHub Webhook, Gemini (sees image), Pinterest (image + video) v3",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": null,
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Receive Product from GitHub",
          "messages": [
            {
              "category": "setupreq",
              "severity": "error",
              "message": "Webhook: Value must not be empty."
            }
          ]
        },
        "parameters": [
          {
            "name": "hook",
            "type": "hook:gateway-webhook",
            "label": "Webhook",
            "required": true
          },
          {
            "name": "maxResults",
            "type": "number",
            "label": "Maximum number of results"
          }
        ]
      }
    },
    {
      "id": 8,
      "module": "gemini-ai:uploadAFile",
      "version": 1,
      "parameters": {
        "__IMTCONN__": 14591668
      },
      "filter": null,
      "mapper": {
        "file_data": "{{toBinary(1.image_base64; base64)}}",
        "file_name": "{{1.product_id}}.jpg",
        "useFileSearchStore": false
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Upload Pin Image to Gemini"
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "Aishat's Gemini AI connection"
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:gemini-ai-q9zyjp",
            "label": "Connection",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "file_name",
            "type": "text",
            "label": "Name",
            "required": true,
            "semantic": "file:name"
          },
          {
            "name": "file_data",
            "type": "buffer",
            "label": "Data",
            "required": true,
            "semantic": "file:data"
          },
          {
            "name": "useFileSearchStore",
            "type": "boolean",
            "label": "Use File Search Store",
            "default": false,
            "required": false
          }
        ]
      },
      "onerror": [
        {
          "id": 15,
          "module": "builtin:Resume",
          "version": 1,
          "mapper": {},
          "metadata": {
            "designer": {
              "x": 300,
              "y": 300,
              "name": "Upload failed: use no-AI text"
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "module": "gemini-ai:createACompletionGeminiPro",
      "version": 1,
      "parameters": {
        "__IMTCONN__": 14591668
      },
      "mapper": {
        "model": "gemini-2.5-flash",
        "contents": [
          {
            "role": "user",
            "parts": [
              {
                "type": "file",
                "file_data": {
                  "file_uri": "{{8.uri}}",
                  "mime_type": "{{1.image_content_type}}"
                }
              },
              {
                "type": "text",
                "text": "You write Pinterest pin copy. Pin type: {{1.pin_type}} (image = one AliExpress product, video = one product shown in a video, roundup = a collage list of several products). Product name from the store: {{1.product_title}}. Category: {{1.niche}}. Look at the attached pin image and describe what you can actually see, together with what the product name says. Return exactly two lines and nothing else, with no blank line between them. Line 1: a catchy, keyword-rich Pinterest title, maximum 90 characters. Line 2: an engaging description of 2 sentences, maximum 280 characters, saying what it is and how it helps, ending with a gentle invitation to save the pin. Do not use labels, numbering, hashtags, emojis, quotation marks, prices, or claims about discounts or shipping. Do not invent features that are not visible in the image or stated in the product name."
              }
            ]
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Gemini Looks at Image, Writes Title and Description"
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "Aishat's Gemini AI connection"
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:gemini-ai-q9zyjp",
            "label": "Connection",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "model",
            "type": "select",
            "label": "AI Model",
            "dynamic": true,
            "grouped": true,
            "required": true
          },
          {
            "name": "contents",
            "spec": [
              {
                "name": "role",
                "type": "select",
                "label": "Role",
                "required": true,
                "validate": {
                  "enum": [
                    "user",
                    "model"
                  ]
                }
              },
              {
                "name": "parts",
                "spec": [
                  {
                    "name": "type",
                    "type": "select",
                    "label": "Message Type",
                    "required": true,
                    "validate": {
                      "enum": [
                        "text",
                        "file",
                        "functionCall",
                        "functionResponse"
                      ]
                    }
                  },
                  {
                    "name": "thoughtSignature",
                    "type": "text",
                    "label": "Thought Signature"
                  }
                ],
                "type": "array",
                "label": "Parts",
                "required": true
              }
            ],
            "type": "array",
            "label": "Messages",
            "required": true
          },
          {
            "name": "system_instruction",
            "spec": [
              {
                "name": "parts",
                "spec": {
                  "spec": [
                    {
                      "name": "text",
                      "type": "text",
                      "label": "Value"
                    }
                  ],
                  "type": "collection",
                  "label": "Prompt"
                },
                "type": "array",
                "label": "Prompts",
                "labels": {
                  "add": "Add a System Prompt"
                }
              }
            ],
            "type": "collection",
            "label": "System Instructions"
          },
          {
            "name": "safetySettings",
            "spec": [
              {
                "name": "category",
                "type": "select",
                "label": "Category",
