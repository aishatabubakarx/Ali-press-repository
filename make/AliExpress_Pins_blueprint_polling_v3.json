                "label": "Top P",
                "advanced": true,
                "required": false,
                "validate": {
                  "max": 1,
                  "min": 0
                }
              },
              {
                "name": "topK",
                "type": "number",
                "label": "Top K",
                "advanced": true,
                "required": false
              },
              {
                "name": "thinkingConfig",
                "spec": [
                  {
                    "name": "thinkingBudget",
                    "type": "number",
                    "label": "Thinking Budget",
                    "advanced": true,
                    "required": false
                  },
                  {
                    "name": "include_thoughts",
